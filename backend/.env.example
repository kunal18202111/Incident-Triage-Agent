# LLM_PROVIDER: mock | gemini | grok
# "mock" needs no API key and runs the full plan/act/observe/reflect + HITL loop
# with a deterministic rule-based planner. Use gemini/grok for real LLM planning.
LLM_PROVIDER=mock

# Required if LLM_PROVIDER=gemini (https://aistudio.google.com/apikey - free tier)
# Single key:
GEMINI_API_KEY=
# OR comma-separated keys for automatic rotation when one hits its free-tier quota
# (GEMINI_API_KEYS takes priority over GEMINI_API_KEY if both are set):
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-flash-lite-latest

# Required if LLM_PROVIDER=grok (https://console.x.ai)
XAI_API_KEY=
GROK_MODEL=grok-beta
